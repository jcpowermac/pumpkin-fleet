# Single source for every pinned fleet value. Scripts source this file.
# Do not edit by hand at run time; edit + commit (or via a script that rewrites it).

# --- Proxmox ---
PVE_HOST=root@172.31.12.99
PVE_BRIDGE=vmbr1
PVE_VM_STORAGE=pool            # KVM disks (zpool "pool", 1.9 TB)
PVE_ISO_DIR=/var/lib/vz/images # PVE "local" storage ISO dir (unused by spike; kept for reference)

# --- Network (VLAN 45) ---
FLEET_SUBNET=10.10.10.0/24
FLEET_GW=10.10.10.1
IP_TRAEFIK=10.10.10.10
IP_VELOCITY=10.10.10.52
IP_AUTHENTIK=10.10.10.53
IP_LOBBY=10.10.10.54
IP_PLUGINS=10.10.10.55
IP_VANILLA=10.10.10.56
IP_NEOFORGE=10.10.10.57
IP_SPIKE=10.10.10.99

# --- VMID allocation ---
VMID_SPIKE=190
VMID_LOBBY=201
VMID_PLUGINS=202
VMID_VANILLA=203
VMID_NEOFORGE=204
VMID_AUTHENTIK=150
VMID_VELOCITY=205

# --- Container images ---
# Server image versions + sha256 pins live in containers/images.json (single source of
# truth, read by .github/workflows/containers.yml). Set the tag deploys should pull here
# once the GitHub Actions run has pushed it. There is no `latest` tag by design.
CONTAINER_REGISTRY=ghcr.io          # ghcr.io/<owner>/pumpkin-fleet/<image>:<version>

# --- Fleet OS image (BlueBuild: recipes/fleet.yml -> .github/workflows/os.yml) ---
# Public: anonymous pull, no credentials on the nodes. Rebasing onto the same tag is a
# no-op in rpm-ostree, so pin a digest when a rebuild must be picked up (spike-notes §14).
# Two channels, same discipline as the server images: the daily BlueBuild build moves only
# :latest, and that is the OS canary channel — CANARY_NODE (a name, never a VMID) is the only
# node that follows it. :stable moves only when a human dispatches the promote-os job in os.yml
# with the digest :latest actually carries, so the other nodes never track an unreviewed build.
OS_IMAGE=ghcr.io/jcpowermac/pumpkin-os
OS_TAG=stable
OS_TAG_CANARY=latest
CANARY_NODE=plugins

# --- Server image channels (containers.yml: a merge publishes <image>:stable-next for the
# canary node; scripts/promote.sh moves <image>:stable to a published digest) ---
FLEET_CHANNEL=stable
FLEET_CHANNEL_CANARY=stable-next

# --- Node reboot window (systemd OnCalendar; the quadlet/reboot units consume it) ---
# Quoted: the value has spaces and a glob, and pins.env is sourced by shell scripts.
REBOOT_ONCALENDAR="Sun *-*-* 05:00"

# --- MC data disk (second disk on each game VM: pool/mcdata/<node>) ---
MC_DATA_DISK_GB=40
# Device the node's /srv/<node>/data .mount unit binds: /dev/disk/by-id/<entry>. The deploy
# prefers a by-id entry that names the node, so this pin is what a host zvol needs — its guest
# name is slot-derived (scsi-0QEMU_QEMU_HARDDISK_drive-scsi1), which no node-name match finds.
#
# Read it off a node and set it BEFORE the first deploy of the migration order:
#   ssh core@<ip> ls /dev/disk/by-id     # the scsi1 entry, …HARDDISK_drive-scsi1
# The deploy writes the .mount unit that 25-migrate-data.sh reads its device out of, so with
# the pin unset the deploy aborts before it writes anything and the migration refuses.
#
# One value for the fleet: scsi1 is the world disk on every node, so the same slot-derived
# entry names this node's own zvol — but it cannot prove the device *is* pool/mcdata/<node>
# (a VM with a foreign scsi1 needs 15-ensure-data-disks.sh's refusal, not this pin).
#
# A wrong pin is not harmless: the deploy formats whatever it names when that device carries
# no filesystem (mkfs.xfs on someone else's disk), refuses one that carries a non-XFS one, and
# mounts the result at /srv/<node>/data. A pin this node does not list is refused outright.
FLEET_DATA_DEV=

# --- Base OS image (pinned at spike time; see docs/spike-notes.md) ---
FCOS_STREAM=stable
FCOS_BUILD=45.20261030.3.1
# Full registry ref: templates/fleet.ign.butane rebases on "${UCORE_IMAGE}:${UCORE_TAG}" as
# written here, so the spike base and the fleet OS image are spelled the same way.
UCORE_IMAGE=ghcr.io/ublue-os/ucore
UCORE_TAG=stable-20261122    # pinned: verified present on ghcr 2026-11-22

# --- Spike VM shape ---
SPIKE_VMID=$VMID_SPIKE
SPIKE_NAME=ucore-spike
SPIKE_HOSTNAME=ucore-golden
SPIKE_MEM_MB=4096
SPIKE_CORES=4
SPIKE_DISK_GB=40
SPIKE_IP4=10.10.10.99/24
CORE_SSH_PUB_KEY_FILE=$HOME/.ssh/id_ed25519.pub
