# Single source for every pinned fleet value. Scripts source this file.
# Do not edit by hand at run time; edit + commit (or via a script that rewrites it).

# --- Proxmox ---
PVE_HOST=root@172.31.12.99
PVE_BRIDGE=vmbr1
PVE_VM_STORAGE=pool            # KVM disks (zpool "pool", 1.9 TB)
PVE_ISO_DIR=/var/lib/vz/images # PVE "local" storage ISO dir (unused by spike; kept for reference)

# --- Network (VLAN 45) ---
FLEET_SUBNET=10.10.10.0/24
FLEET_GW=10.10.10.1
IP_TRAEFIK=10.10.10.10
IP_VELOCITY=10.10.10.52
IP_AUTHENTIK=10.10.10.53
IP_LOBBY=10.10.10.54
IP_PLUGINS=10.10.10.55
IP_VANILLA=10.10.10.56
IP_NEOFORGE=10.10.10.57
IP_SPIKE=10.10.10.99

# --- VMID allocation ---
VMID_SPIKE=190
VMID_LOBBY=201
VMID_PLUGINS=202
VMID_VANILLA=203
VMID_NEOFORGE=204
VMID_AUTHENTIK=150

# --- Images (pinned at spike time; see docs/spike-notes.md) ---
FCOS_STREAM=stable
FCOS_BUILD=45.20261030.3.1
UCORE_IMAGE=ucore
UCORE_TAG=stable-20261122    # pinned: verified present on ghcr 2026-11-22

# --- Spike VM shape ---
SPIKE_VMID=$VMID_SPIKE
SPIKE_NAME=ucore-spike
SPIKE_HOSTNAME=ucore-golden
SPIKE_MEM_MB=4096
SPIKE_CORES=4
SPIKE_DISK_GB=40
SPIKE_IP4=10.10.10.99/24
CORE_SSH_PUB_KEY_FILE=$HOME/.ssh/id_ed25519.pub
