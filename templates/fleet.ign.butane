# FCOS → uCore ignition template (v3: one-shot provisioning).
# FCOS QEMU/proxmox images only read fw_cfg while /ignition.firstboot exists on the
# extboot partition (grub 05_ignition.cfg); coreos-ignition-firstboot-complete deletes
# it after the first ignition. Re-arm it before reboot to re-apply this config.
# envsubst (pinned vars) → butane → ignition.
variant: fcos
version: 1.5.0

passwd:
  users:
    - name: core
      groups:
        - wheel
        - systemd-journal
      # No password, by design. Access is SSH-key only: a committed password hash is
      # a committed password. If a serial-console login is ever genuinely needed, set
      # one interactively from an SSH session (`passwd core`) - never bake it in here.
      ssh_authorized_keys:
        - ${CORE_SSH_PUB_KEY}

systemd:
  units:
    # PVE qcow2 import makes the disk look cloned -> clone-detection services
    # drop to emergency shell. Mask both (vSphere flow did not need this).
    - name: coreos-ignition-unique-boot.service
      mask: true
    # cockpit.service is a uCore unit — it does not exist yet on stock FCOS, so it cannot be
    # enabled from here (Ignition would silently no-op). fleet-provision.sh enables it in its
    # post-rebase branch instead.
    # (coreos-gpt-setup stays enabled: it grows the root partition to the full disk)
    # One boot does everything: persistent static IP (NM connection lands in the
    # deployment's /var), unsigned + signed uCore rebase, reboot into uCore.
    - name: fleet-provision.service
      enabled: true
      contents: |
        [Unit]
        Description=Fleet one-shot provisioning (static IP + uCore rebase + reboot)
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/local/bin/fleet-provision.sh

        [Install]
        WantedBy=multi-user.target

storage:
  files:
    - path: /usr/local/bin/fleet-provision.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/sh
          set -e
          IFACE=""
          for i in $(seq 1 12); do
            IFACE=$(/usr/bin/nmcli -t -f DEVICE device 2>/dev/null | grep -vE "^(lo|veth)" | head -1)
            [ -n "$IFACE" ] && break
            sleep 5
          done
          [ -n "$IFACE" ] || { echo "fleet-provision: no interface found"; exit 1; }
          echo "fleet-provision: using $IFACE"
          /usr/bin/nmcli connection delete fleet-static 2>/dev/null || true
          /usr/bin/nmcli connection add type ethernet con-name fleet-static ifname "$IFACE" ipv4.method manual ipv4.addresses "${SPIKE_IP4}" ipv4.gateway "${FLEET_GW}" ipv4.dns "${FLEET_GW}" ipv6.method disabled
          ok=""
          for i in $(seq 1 24); do /usr/bin/nmcli connection up fleet-static 2>/dev/null && ok=1 && break; sleep 5; done
          [ -n "$ok" ] || { echo "fleet-provision: static IP failed"; exit 1; }
          echo "fleet-provision: $(/usr/bin/ip -4 addr show $IFACE | grep inet)"

          # Idempotent guard. Without it this unit rebases + reboots on every boot, forever:
          # after the first run the target image is the booted deployment, the rebase becomes a
          # no-op, and the unconditional reboot turns the node into a reboot loop with no
          # network. It greps the image the render targets (spike-notes §14: a node booted on
          # ghcr.io/jcpowermac/pumpkin-os does not match a hardcoded 'ublue-os/ucore' grep).
          # shortcut: image, not tag — moving a booted node between tags/digests is the update
          # path (rebase by @sha256), not first-boot Ignition.
          if /usr/bin/rpm-ostree status --booted 2>/dev/null | grep -q "${UCORE_IMAGE}"; then
            echo "fleet-provision: already running ${UCORE_IMAGE} — network set, nothing else to do"
            # uCore-only services cannot be enabled before the rebase; do it here.
            # cockpit-ws is a Podman container in uCore (the RPM is deliberately absent),
            # and cockpit-files gives the ops class its file manager.
            /usr/bin/systemctl enable --now cockpit.service 2>/dev/null || true
            /usr/bin/systemctl enable --now qemu-guest-agent.service 2>/dev/null || true
            # sssd -> authentik LDAP outpost (CT 150). The conf is baked in by Ignition above;
            # the outpost listens on 6636, a non-standard LDAPS port SELinux would otherwise
            # reject (connect() EACCES for sssd_be). authselect is already on the sssd profile
            # by default on FCOS/uCore; the select re-asserts it.
            /usr/bin/semanage port -a -t ldap_port_t -p tcp 6636 2>/dev/null || true
            /usr/bin/authselect select sssd 2>/dev/null || true
            /usr/bin/systemctl enable --now sssd.service 2>/dev/null || true
            # Home dir for the LDAP user (uid 2007, primary group fleet-admins 29163 —
            # both come from authentik; see docs/ldap-handoff.md §11). Without it,
            # cockpit's beiboot agent-socket prep and cockpit-bridge choke on a
            # missing homedir, and nothing on the node creates it (authselect's
            # sssd profile has no pam_mkhomedir).
            /usr/bin/install -d -o 2007 -g 29163 -m 0750 /home/jcallen 2>/dev/null || true
            exit 0
          fi

          # NB: no `curl -f` here. ghcr.io answers 405 to HEAD on / and 401 on /v2/, so any
          # status check that fails on 4xx reports "no egress" on a perfectly good network.
          # Reachability only: curl exits non-zero on DNS/TLS/connect failure, which is what we want.
          up=""
          for i in $(seq 1 36); do /usr/bin/curl -sS --max-time 10 -o /dev/null https://ghcr.io/v2/ >/dev/null 2>&1 && up=1 && break; sleep 10; done
          [ -n "$up" ] || { echo "fleet-provision: no ghcr.io egress"; exit 1; }
          echo "fleet-provision: rebasing to ${UCORE_IMAGE}:${UCORE_TAG} (pull ~10min)"
          # --bypass-driver: updates are owned by Zincati on stock FCOS
          /usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:${UCORE_IMAGE}:${UCORE_TAG} || exit 1
          echo "fleet-provision: staged; rebooting into uCore"
          /usr/bin/systemctl reboot

    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: ${SPIKE_HOSTNAME}

    # authentik LDAP -> sssd. Written at FCOS first boot; /etc survives the uCore rebase.
    # Gotchas baked in (see docs/ldap-handoff.md §10): the outpost's user DN uses cn= as the
    # name attribute (uid is a UUID), and group membership is RFC 2307bis (member DNs).
    # enumerate=true so group members resolve even on a cold cache. root:root 0640 because
    # the sssd group may not exist yet when Ignition runs.
    - path: /etc/sssd/sssd.conf
      # Ignition files default to root:root (butane's fcos variant has no owner key),
      # which is what we want: the sssd group may not exist yet at first-boot time.
      mode: 0640
      overwrite: true
      contents:
        inline: |
          [sssd]
          config_file_version = 2
          services = nss, pam
          domains = ldap.goauthentik.io

          [nss]
          filter_groups = root
          filter_users = root

          [pam]
          offline_credentials_expiration = 60

          [domain/ldap.goauthentik.io]
          id_provider = ldap
          auth_provider = ldap
          chpass_provider = ldap
          ldap_uri = ldaps://${IP_AUTHENTIK}:6636
          ldap_search_base = dc=ldap,dc=goauthentik,dc=io
          ldap_user_search_base = ou=users,dc=ldap,dc=goauthentik,dc=io
          ldap_group_search_base = ou=groups,dc=ldap,dc=goauthentik,dc=io
          ldap_user_name = cn
          ldap_schema = rfc2307bis
          ldap_default_bind_dn = cn=${SSSD_BIND_USER},ou=users,dc=ldap,dc=goauthentik,dc=io
          ldap_default_authtok = ${SSSD_BIND_AUTHTOK}
          ldap_tls_reqcert = never
          enumerate = true
          default_shell = /bin/bash
          cache_credentials = true
